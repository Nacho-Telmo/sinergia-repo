# Maintainer: Sinergia Comunidad Linuxera sinergia.comunidad.linuxuera@gmail.com
pkgname=sinergia-appimage-manager
pkgver=1.0.1
pkgrel=9
pkgdesc="Gestor de AppImages para Sinergia con integración a entorno y carpeta centralizada"
arch=('any')
url="https://github.com/Nacho-Telmo/sinergia-repo"
license=('GPL3')
depends=('python' 'python-pyqt6')
source=('appimage-manager.py'
        'appimage-manager.desktop'
        'appimage-manager.png')
sha256sums=('e9955d375b21855b88efd7a08d02a2fddf63248094042536ecd0abbabd243ad8'
            'cec5285e17bbe254c7ed2c5f30229d533a9d8e2c35d8357f29ecdc207c566f65'
            'e64306d393efd92682ca7deed09b8a27e7c98586807f090b071b5a3c882469a8')

package() {
    install -d "$pkgdir/usr/bin"
    install -d "$pkgdir/usr/share/sinergia-appimage-manager"
    install -d "$pkgdir/usr/share/applications"
    install -d "$pkgdir/usr/share/icons/hicolor/128x128/apps"

    # Instalar el script principal
    install -m 755 "$srcdir/appimage-manager.py" "$pkgdir/usr/share/sinergia-appimage-manager/appimage-manager.py"

    # Instalar el archivo .desktop para el menú
    install -m 644 "$srcdir/appimage-manager.desktop" "$pkgdir/usr/share/applications/sinergia-appimage-manager.desktop"

    # Instalar el ícono personalizado en PNG
    install -m 644 "$srcdir/appimage-manager.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/appimage-manager.png"

    # Enlace simbólico para el comando global
    ln -s /usr/share/sinergia-appimage-manager/appimage-manager.py "$pkgdir/usr/bin/sinergia-appimage-manager"
}

# Maintainer: Ignacio Ezcurra <sinergia.comunidad.linuxera@gmail.com>
pkgname=sinergia-conky-manager
pkgver=1.1.0
pkgrel=1
pkgdesc="Gestor PyQt6 de widgets de escritorio minimalistas para Conky en Sinergia"
arch=('any')
url="https://github.com/Nacho-Telmo/sinergia-conky-manager"
license=('GPL3')
depends=('conky' 'python' 'python-pyqt6')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    # Prepara un directorio limpio con los fuentes necesarios
    mkdir -p "${pkgname}-${pkgver}"
    cp -r main.py themes sinergia-conky-manager.desktop "${pkgname}-${pkgver}/"
}

package() {
    cd "${pkgname}-${pkgver}"

    # 1. Crear directorios de destino en el sistema
    install -dm755 "$pkgdir/usr/bin"
    install -dm755 "$pkgdir/usr/share/sinergia-conky/themes"
    install -dm755 "$pkgdir/usr/share/applications"

    # 2. Instalar el script principal del gestor como ejecutable en /usr/bin
    install -m755 main.py "$pkgdir/usr/bin/sinergia-conky-manager"

    # 3. Copiar los temas de Conky a la ruta compartida del sistema
    cp -r themes/* "$pkgdir/usr/share/sinergia-conky/themes/"

    # 4. Instalar el archivo .desktop para que aparezca en el menú de aplicaciones
    install -m644 sinergia-conky-manager.desktop "$pkgdir/usr/share/applications/sinergia-conky-manager.desktop"
}

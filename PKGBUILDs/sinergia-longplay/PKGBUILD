# Maintainer: Ignacio Ezcurra <sinergia.comunidad.linuxera@gmail.com>
pkgname=sinergia-longplay
pkgver=1.0.0
pkgrel=2
pkgdesc="Reproductor y descargador de álbumes completos de música para Sinergia Linux"
arch=('any')
url="https://github.com/Nacho-Telmo/sinergia-longplay"
license=('GPL3')
depends=('python' 'python-pyqt6' 'yt-dlp')
optdependents=('xdg-utils: para abrir la carpeta de música')
source=('main.py' 'sinergia-longplay.desktop' 'sinergia-longplay.svg')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    # Instalar el script principal de Python
    install -Dm755 "$srcdir/main.py" "$pkgdir/usr/share/sinergia-longplay/main.py"

    # Instalar el archivo .desktop para el menú de aplicaciones
    install -Dm644 "$srcdir/sinergia-longplay.desktop" "$pkgdir/usr/share/applications/sinergia-longplay.desktop"

    # Instalar el logo SVG en el tema hicolor para que el sistema lo reconozca
    install -Dm644 "$srcdir/sinergia-longplay.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sinergia-longplay.svg"

    # Crear un enlace simbólico ejecutable global en /usr/bin
    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/share/sinergia-longplay/main.py "$pkgdir/usr/bin/sinergia-longplay"
}

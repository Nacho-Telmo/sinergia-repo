# Maintainer: Ignacio Ezcurra (Nacho-Telmo) <sinergia.linuxera@gmail.com>
pkgname=sinergia-reflector-top
pkgver=1.0.6
pkgrel=2
pkgdesc="Interfaz gráfica para Reflector para optimizar espejos de Arch Linux"
arch=('any')
url="https://github.com/Nacho-Telmo/Sinergia"
license=('GPL3')
depends=('python' 'python-pyqt6' 'reflector')
source=('reflector_gui.py'
        'sinergia-reflector-top.desktop'
        'sinergia-reflector-top.png'
        'LICENSE')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 reflector_gui.py "$pkgdir/usr/bin/$pkgname"
    install -Dm644 $pkgname.desktop "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 $pkgname.png "$pkgdir/usr/share/pixmaps/$pkgname.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

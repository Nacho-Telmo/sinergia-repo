# Maintainer: Nacho Telmo <sinergia.comunidad.linuxera@gmail.com>
pkgname=sinergia-video-compressor
pkgver=1.0.0
pkgrel=1
pkgdesc="Herramienta local y privada para comprimir videos con perfiles optimizados mediante ffmpeg"
arch=('any')
url="https://github.com/Nacho-Telmo/sinergia-repo"
license=('GPL3')
depends=('python' 'python-pyqt6' 'ffmpeg')
optdepends=('xdg-desktop-portal: integración con Wayland y gestor de archivos')
source=('main.py'
        'logo.svg'
        'sinergia-video-compressor.desktop')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
    # Crear la estructura de directorios en el paquete
    install -dm755 "$pkgdir/usr/bin"
    install -dm755 "$pkgdir/usr/share/applications"
    install -dm755 "$pkgdir/usr/share/icons/hicolor/scalable/apps"

    # Instalar el script principal y renombrarlo como comando ejecutable
    install -m755 "$srcdir/main.py" "$pkgdir/usr/bin/sinergia-video-compressor"

    # Instalar el archivo .desktop
    install -m644 "$srcdir/sinergia-video-compressor.desktop" "$pkgdir/usr/share/applications/"

    # Instalar el icono vectorial SVG
    install -m644 "$srcdir/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sinergia-video-compressor.svg"
}

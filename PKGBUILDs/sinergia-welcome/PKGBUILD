# Maintainer: Nacho <sinergia.linux@gmail.com>
pkgname=sinergia-welcome
pkgver=1.0.0
pkgrel=7
pkgdesc="Centro de bienvenida y control optimizado para Arch Linux por Sinergia"
arch=('any')
url="https://nacho-telmo.github.io/sinergia-repo/"
license=('GPL3')
depends=('python' 'python-pyqt6' 'qt6-base' 'libx11')
optdepends=(
    'sinergia-reflector-top: para refrescar los espejos de pacman'
    'sinergia-cleaner: para limpiar caché y paquetes huérfanos'
    'fastfetch: para visualizar información del sistema'
    'konsole: terminal predeterminada para ejecutar scripts'
    'xfce4-terminal: terminal alternativa'
)
source=(
    "main.py"
    "sinergia-welcome.desktop"
)
sha256sums=('SKIP' 'SKIP')

package() {
    install -Dm644 "$srcdir/main.py" "$pkgdir/usr/share/sinergia-welcome/main.py"
    install -Dm644 "$srcdir/sinergia-welcome.desktop" "$pkgdir/usr/share/applications/sinergia-welcome.desktop"
}

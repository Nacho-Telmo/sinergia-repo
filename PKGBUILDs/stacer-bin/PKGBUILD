# Maintainer: Ignacio Ezcurra <nacho@sinergia.com>
pkgname=stacer-bin
pkgver=1.8.0
pkgrel=1
_tag="v1.8.0"
pkgdesc="Linux System Optimizer and Monitoring (QuentiumYT fork)"
arch=('x86_64')
url="https://github.com/QuentiumYT/Stacer"
license=('GPL3')
depends=('glibc' 'gcc-libs' 'hicolor-icon-theme' 'qt6-charts')
provides=('stacer')
conflicts=('stacer' 'stacer-git')
source=("https://github.com/QuentiumYT/Stacer/releases/download/${_tag}/Stacer-${pkgver}-x86_64.AppImage"
        "stacer.desktop")
sha256sums=('SKIP'
            'SKIP')

prepare() {
    chmod +x "Stacer-${pkgver}-x86_64.AppImage"
    ./"Stacer-${pkgver}-x86_64.AppImage" --appimage-extract
}

package() {
    cd "${srcdir}/squashfs-root"

    # Instalar el binario principal (ubicado en usr/bin dentro de la AppImage o en la raíz)
    if [ -f "usr/bin/stacer" ]; then
        install -Dm755 "usr/bin/stacer" "${pkgdir}/usr/bin/stacer"
    elif [ -f "stacer/stacer" ]; then
        install -Dm755 "stacer/stacer" "${pkgdir}/usr/bin/stacer"
    else
        # Búsqueda general si cambia de ruta
        find . -maxdepth 3 -type f -name "stacer" -executable -exec install -Dm755 {} "${pkgdir}/usr/bin/stacer" \;
    fi

    # Archivo .desktop local
    install -Dm644 "${srcdir}/stacer.desktop" "${pkgdir}/usr/share/applications/stacer.desktop"

    # Iconos en alta calidad
    if [ -d "usr/share/icons/hicolor" ]; then
        cp -r usr/share/icons/hicolor "${pkgdir}/usr/share/icons/"
    elif [ -d "icons/hicolor" ]; then
        install -dm755 "${pkgdir}/usr/share/icons/hicolor"
        cp -r icons/hicolor/* "${pkgdir}/usr/share/icons/hicolor/"
    fi
}

# Maintainer: Nacho <sinergia.comunidad.linuxera@gmail.com>
pkgname=vortex-dark-icons
pkgver=1.0
pkgrel=4
pkgdesc="Tema de íconos oscuros Vortex para KDE Plasma"
arch=('any')
url="https://store.kde.org/p/1493433"
license=('GPL3')
depends=('hicolor-icon-theme')
source=("Vortex-Dark.tar.xz")
sha256sums=('SKIP')

package() {
    mkdir -p "$pkgdir/usr/share/icons/Vortex-Dark"
    
    # Mover el contenido de la subcarpeta directamente a la raíz del tema
    if [ -d "$srcdir/Vortex-Dark-Icons" ]; then
        cp -r "$srcdir/Vortex-Dark-Icons"/* "$pkgdir/usr/share/icons/Vortex-Dark/"
    elif [ -d "$srcdir/Vortex-Dark" ]; then
        cp -r "$srcdir/Vortex-Dark"/* "$pkgdir/usr/share/icons/Vortex-Dark/"
    else
        cp -r "$srcdir"/* "$pkgdir/usr/share/icons/Vortex-Dark/"
    fi
    
    # Limpiar el comprimido si se copió por accidente
    rm -f "$pkgdir/usr/share/icons/Vortex-Dark/Vortex-Dark.tar.xz"
    
    # Ajustar permisos adecuados
    find "$pkgdir/usr/share/icons/Vortex-Dark" -type f -exec chmod 644 {} +
    find "$pkgdir/usr/share/icons/Vortex-Dark" -type d -exec chmod 755 {} +
}

# Maintainer: Nacho <sinergia.comunidad.linuxera@gmail.com>
pkgname=yaru-colors-icon-theme
pkgver=21.04
pkgrel=2
pkgdesc="Fork del tema de íconos Yaru de Ubuntu en diferentes colores (Yaru-Colors)"
arch=('any')
url="https://github.com/Jannomag/Yaru-Colors"
license=('GPL3' 'CCPL')
depends=('hicolor-icon-theme' 'gtk-update-icon-cache')
makedepends=('git')
provides=('yaru-colors-icon-theme')
conflicts=('yaru-colors-icon-theme')
source=("git+https://github.com/Jannomag/Yaru-Colors.git")
sha256sums=('SKIP')

package() {
    cd "$srcdir/Yaru-Colors"
    
    install -d "$pkgdir/usr/share/icons"
    
    # Copiar TODAS las carpetas dentro de Icons (incluye Yaru base + variantes)
    if [ -d "Icons" ]; then
        cp -r Icons/* "$pkgdir/usr/share/icons/"
    fi
}
